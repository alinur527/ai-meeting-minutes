AI_MODE=real
AI_PORT=8000
# Host-only port; use 11435 when Windows Ollama already occupies 11434.
# Containers still use http://ollama:11434 below.
OLLAMA_PORT=11435
MODEL_DIR=/models
ASR_MODEL=Systran/faster-whisper-large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
LOW_MEMORY_MODE=1
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_RETRIES=2
MAX_AUDIO_MB=200
MAX_AUDIO_SECONDS=1800
DIARIZATION_DEVICE=cpu
LLM_MAX_INPUT_BYTES=16000
LLM_CONTEXT_TOKENS=32768
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
MODEL_VERSION=hackalem-ai-0.1.0
# Must match AI_INTERNAL_TOKEN on the backend laptop.
INTERNAL_TOKEN=
